# Cloudflare Pages / Netlify response headers.
#
# The service worker and manifest must always be re-checked, or an installed app can stay pinned
# to an old version. Everything under /assets/ has a content hash in its name, so it can be
# cached for a year.
/sw.js
  Cache-Control: no-cache
/workbox-*.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
