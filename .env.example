# Copy to .env and fill in. These are the SAME values the PrintAir website uses —
# the app shares its Supabase project, so accounts and data are the same in both.
#
# Hosted: Supabase dashboard -> Project Settings -> API.
# Local:  run `npx supabase start` in the original Printair repo and use the printed API URL + anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# There is deliberately no service-role key here. This repo is front end only and must never hold one.
