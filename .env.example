# Copy to .env and fill in. These are the SAME values the PrintAir website uses —
# the app shares its Supabase project, so accounts and data are the same in both.
#
# Hosted: Supabase dashboard -> Project Settings -> API.
# Local:  run `npx supabase start` in the original Printair repo and use the printed API URL + anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The app's own public address, no trailing slash, e.g. https://app.printair.ph
# Used only so shared links show their picture. Optional.
VITE_APP_URL=

# "Happening on PrintAir" activity pill and delivered-orders total. Leave unset until the backend
# function public_activity() exists (docs/BACKEND-FOLLOWUPS.md section 6); then set to 1.
VITE_ACTIVITY_FEED=

# Server-side only: the seed script and the backend test suites (npm run seed / test:backend),
# against a LOCAL Supabase stack. Never expose it to the browser, never set it on the web host.
SUPABASE_SERVICE_ROLE_KEY=
